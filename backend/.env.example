# PhysioTrack backend — environment. Copy to .env for local dev. NEVER commit .env.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://physiotrack:physiotrack@localhost:5432/physiotrack?schema=public

# Session / crypto
SESSION_COOKIE_NAME=pt_session
SESSION_TTL_MINUTES=30
REFRESH_TTL_DAYS=14
# 32+ byte random secret for signing/hashing session material (set a real value)
APP_SECRET=

# WebAuthn (passkeys)
RP_ID=localhost
RP_NAME=PhysioTrack
RP_ORIGIN=http://localhost:5173

# Jarvis connector (external service) — no keys in code
JARVIS_CONNECTOR_ENABLED=false
JARVIS_SERVICE_ACCOUNT_ID=
JARVIS_ALLOWED_ORIGIN=

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
